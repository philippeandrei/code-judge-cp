Content-Type: application/json

{
  "name": "Grand Prix 2027",
  "startTime": "2026-11-01T14:00:00",
  "endTime": "2026-11-01T11:00:00",
  "problems": [
    {
      "id": "a579107a-b0e6-47e2-922a-c860793b8a1a",
